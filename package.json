{
  "name": "carvo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @carvo/api",
    "dev:api:local": "npm run dev:local -w @carvo/api",
    "dev:web": "npm run dev -w @carvo/web",
    "lint": "eslint .",
    "format": "prettier --check .",
    "dup": "jscpd",
    "test": "npm run test --workspaces --if-present",
    "test:db": "npm run test:db -w @carvo/api",
    "check": "npm run lint && npm run format && npm run dup && npm test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jscpd": "4.3.0",
    "prettier": "3.10.1",
    "supabase": "3.1.0"
  },
  "overrides": {
    "@opennextjs/aws": {
      "cookie": "0.7.2"
    }
  }
}
