# Copy to deploy/.env on the VM and fill in. Never commit real values.
# These are the stack's own settings; each app's secrets stay in apps/api/.env.local and apps/web/.env.local.

# The public host name Caddy answers for and gets a certificate for.
SITE_ADDRESS=example.co.ke
# Where the certificate authority sends expiry notices.
ACME_EMAIL=admin@example.invalid

# Ports Caddy listens on. Leave as they are on the VM.
HTTP_PORT=80
HTTPS_PORT=443

# Which file holds the API's secrets (default: apps/api/.env.local).
# API_ENV_FILE=../apps/api/.env.local

# Public values for the web app. They are written into the browser code when the image is built, so rebuild after
# changing them: docker compose up -d --build web
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=your-maps-key
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
