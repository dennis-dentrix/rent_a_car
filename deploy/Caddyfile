# Caddy on the Oracle VM: the one public entry point. Cloudflare sends traffic here; Caddy sends /api/* to the API
# container and everything else to the web container. Neither app is reachable from outside the VM except through
# this file.
{
	email {$ACME_EMAIL:admin@example.invalid}

	servers {
		# Only Cloudflare's addresses are trusted to say who the visitor is. This list changes rarely; refresh it from
		# https://www.cloudflare.com/ips/ when it does.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# SITE_ADDRESS is the public host name, for example example.co.ke. Caddy gets and renews its certificate itself.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}

	# The apps get the real visitor address, never one the visitor wrote into a header.
	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
			health_uri /api/v1/health
			health_interval 30s
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}
