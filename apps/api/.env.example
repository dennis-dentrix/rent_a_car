# Copy to .env.local and fill in. Never commit real values.

PORT=4000
INTERNAL_JOB_SECRET=change-me

# Staff and admin must sign in with a second factor. Keep this true everywhere except local development.
REQUIRE_STAFF_MFA=true

# Supabase (local values come from: npx supabase status)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deferred, not used yet: Tingg payments (revisit later)
# TINGG_API_BASE_URL=
# TINGG_CLIENT_ID=
# TINGG_CLIENT_SECRET=
# TINGG_WEBHOOK_SECRET=

# Email (ZeptoMail)
ZEPTOMAIL_TOKEN=your-zeptomail-token
# The website's address, for the links in emails.
APP_URL=https://example.invalid
ZEPTOMAIL_FROM=no-reply@example.invalid

# Deferred, not used yet: SMS (Mobile Sasa)
# MOBILESASA_API_TOKEN=
# MOBILESASA_SENDER_ID=

# Cloudflare R2: the private bucket for identity documents and inspection files.
# In production R2_ENDPOINT is left out, and the endpoint comes from R2_ACCOUNT_ID.
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=your-bucket
# The public bucket for blog and guide images, served from the media address (NEXT_PUBLIC_MEDIA_BASE_URL in the web app).
R2_PUBLIC_BUCKET=your-public-bucket
# Local development uses Supabase Storage as a stand-in: the S3 URL, keys, and bucket from `npx supabase status`.
# R2_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
# R2_REGION=local

# Google Places (New): suggests places as a renter types. Without it the suggestions are empty.
GOOGLE_PLACES_API_KEY=your-places-key

SENTRY_DSN=your-sentry-dsn

# Local work only: set to true to skip the authenticator code. Ignored when NODE_ENV is production. Set it in both
# the website's and the API's file.
PAUSE_SECOND_FACTOR=false
