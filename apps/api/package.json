{
  "name": "@rent-a-car/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env.local src/server.js",
    "start": "node src/server.js",
    "dev:worker": "wrangler dev --local --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:db": "DB_TESTS=1 vitest run tests/integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@rent-a-car/shared": "0.1.0",
    "@supabase/supabase-js": "2.119.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pdf-lib": "1.17.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pg": "8.23.1",
    "supertest": "7.3.2",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.166.0"
  }
}
