# Copy to .env.test and fill in from `npx supabase status -o env`. Never commit real values.
# The integration tests load this file, never .env.local, and refuse to run against any host that is not local.
# That keeps .env.local free to point at the hosted project.

INTERNAL_JOB_SECRET=test-job-secret
REQUIRE_STAFF_MFA=false

# Local Supabase only: API_URL, ANON_KEY, SERVICE_ROLE_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Local file storage stands in for R2: STORAGE_S3_URL, S3_PROTOCOL_ACCESS_KEY_ID, S3_PROTOCOL_ACCESS_KEY_SECRET.
R2_ACCOUNT_ID=local
R2_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
R2_REGION=local
R2_BUCKET=rent-a-car-private
R2_PUBLIC_BUCKET=rent-a-car-public
R2_ACCESS_KEY_ID=your-local-s3-access-key-id
R2_SECRET_ACCESS_KEY=your-local-s3-secret

# Leave the mail service unset: a test checks that emails stay queued when no mail service is configured, and a
# token here would make the job try a real send.
SENTRY_DSN=
