# Copy to .env.local and fill in. Only NEXT_PUBLIC_ values reach the browser.
#
# For a Cloudflare build (npm run deploy:staging), put the hosted values in .env.production.local instead: it takes
# priority over .env.local when the site is built, and both are git-ignored. NEXT_PUBLIC_ values and API_URL (which
# decides where /api is passed on to) are written into the build, so rebuild after changing them.

# The public address of the site: canonical links, the sitemap, and structured data use it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where car photos and guide images are kept, as a public address: the media domain in front of the public R2
# bucket. Locally, http://127.0.0.1:54321/storage/v1/object/public/carvo-public. Leave empty to use only the
# photos in public/car-photos, named after each car type (sedan.jpg); guides then show no pictures.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Where the API runs. In development the web app proxies /api to it.
API_URL=http://localhost:4000

# Supabase: the browser signs in with these (public values only, never the service key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=your-maps-key
# The project key (starts with phc_), never a personal API key. Nothing is measured without it, and nothing without the
# visitor's yes. The host is the region the PostHog project was made in; leave it unset for the US region.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Operator sign-in for checking the console by hand (not read by the app). Never prefix with NEXT_PUBLIC_.
DEV_OPERATOR_EMAIL=operator@example.test
DEV_OPERATOR_PASSWORD=

# Local work only: set to true to skip the authenticator code. Ignored when NODE_ENV is production. Set it in both
# the website's and the API's file.
PAUSE_SECOND_FACTOR=false
