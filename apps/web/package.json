{
  "name": "@carvo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "preview": "opennextjs-cloudflare build --openNextConfigPath open-next.config.js && opennextjs-cloudflare preview",
    "build:staging": "opennextjs-cloudflare build --env staging --openNextConfigPath open-next.config.js",
    "release:staging": "opennextjs-cloudflare deploy --env staging",
    "deploy:staging": "npm run build:staging && npm run release:staging"
  },
  "dependencies": {
    "@carvo/shared": "0.1.0",
    "@opennextjs/cloudflare": "1.20.18",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "posthog-js": "1.454.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "autoprefixer": "10.6.2",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.166.0"
  }
}
